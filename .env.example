# RouteMind AI Environment Variables

# Google Maps Platform (Maps JavaScript API, Places API, Routes API)
VITE_GOOGLE_MAPS_API_KEY=

# Supabase Authentication & PostgreSQL (Optional - uses secure local backend session if not set)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend Server Configuration
PORT=3001
VITE_API_URL=http://localhost:3001
